  "dialogues": [
    { "id": "d_mira", "entries": [ "mira_spouse", "mira_first", "mira_main" ],
      "nodes": [
        { "id": "mira_first", "speaker": "Mira", "conditions": [ { "type": "NotFlag", "id": "met_mira" } ], "onEnter": [ { "type": "SetFlag", "id": "met_mira" } ],
          "text": "Oh! You must be the hunter who took the old cottage. I'm Mira. I keep the herb stall here at the crossing. The dead have been walking near the Old Bridge again.",
          "choices": [ { "text": "I'm a hunter. I can deal with them.", "next": "mira_contract" }, { "text": "Tell me about Thornbury.", "next": "mira_lore" } ] },
        { "id": "mira_main", "speaker": "Mira", "text": "Back in one piece, {player}? What do you need?",
          "choices": [
            { "text": "About the Gravebound by the bridge...", "next": "mira_contract", "hideWhenUnavailable": true, "conditions": [ { "type": "ContractStatus", "id": "c_gravebound_cull", "state": "Available" } ] },
            { "text": "The bridge is clear. Here are the bones.", "next": "mira_thanks", "hideWhenUnavailable": true, "conditions": [ { "type": "ContractStatus", "id": "c_gravebound_cull", "state": "Completed" } ], "effects": [ { "type": "ClaimContract", "id": "c_gravebound_cull" }, { "type": "Affinity", "id": "mira", "value": 4 } ] },
            { "text": "Anything stronger out there?", "next": "mira_warden", "hideWhenUnavailable": true, "conditions": [ { "type": "ContractStatus", "id": "c_grave_warden", "state": "Available" } ] },
            { "text": "The Grave Warden is dead.", "next": "mira_warden_done", "hideWhenUnavailable": true, "conditions": [ { "type": "ContractStatus", "id": "c_grave_warden", "state": "Completed" } ], "effects": [ { "type": "ClaimContract", "id": "c_grave_warden" }, { "type": "Affinity", "id": "mira", "value": 5 } ] },
            { "text": "Show me your remedies.", "effects": [ { "type": "OpenShop" } ] },
            { "text": "May I use your mortar and pestle?", "effects": [ { "type": "OpenCrafting" } ] },
            { "text": "I brought you something.", "effects": [ { "type": "OpenGift" } ] },
            { "text": "Would you walk with me one evening?", "next": "mira_courting", "hideWhenUnavailable": true, "conditions": [ { "type": "RelationshipStage", "id": "mira", "state": "friend" }, { "type": "NotFlag", "id": "rel_mira_courting" } ], "effects": [ { "type": "SetRelationship", "id": "mira", "state": "courting" } ] },
            { "text": "Mira... will you marry me?", "next": "mira_engaged", "hideWhenUnavailable": true, "conditions": [ { "type": "Flag", "id": "rel_mira_courting" }, { "type": "NotFlag", "id": "rel_mira_engaged" } ], "effects": [ { "type": "SetRelationship", "id": "mira", "state": "engaged" }, { "type": "TakeItem", "id": "promise_ring", "value": 1 } ] },
            { "text": "Let's not wait. Marry me at the cottage.", "next": "mira_wed", "hideWhenUnavailable": true, "conditions": [ { "type": "Flag", "id": "rel_mira_engaged" }, { "type": "NotFlag", "id": "rel_mira_spouse" } ], "effects": [ { "type": "SetRelationship", "id": "mira", "state": "spouse" } ] },
            { "text": "Goodbye.", "effects": [ { "type": "CloseDialogue" } ] }
          ] },
        { "id": "mira_contract", "speaker": "Mira", "text": "Three of them at least, between the bridge and the ash fields. Bring back their bones so the village knows they're truly down. We pooled sixty gold.",
          "choices": [ { "text": "I'll take the contract.", "next": "mira_accepted", "effects": [ { "type": "AcceptContract", "id": "c_gravebound_cull" } ] }, { "text": "Not yet.", "next": "mira_main" } ] },
        { "id": "mira_accepted", "speaker": "Mira", "text": "Be careful. They raise their blades before they strike, and their eyes flare red. Step aside, then answer. Their helms crack if you aim high.",
          "choices": [ { "text": "I'll be back.", "effects": [ { "type": "CloseDialogue" } ] } ] },
        { "id": "mira_thanks", "speaker": "Mira", "text": "You did it! Here, the village's gold, and two of my tonics. Take those bones to Bram at the forge. He can make you a blade that bites the dead.",
          "choices": [ { "text": "Thank you, Mira.", "next": "mira_main" } ] },
        { "id": "mira_warden", "speaker": "Mira", "text": "The ruined tower past the graves has a crypt beneath it. Something down there keeps the dead walking. Break its helm and they'll believe you at court.",
          "choices": [ { "text": "I'll go down there.", "next": "mira_main", "effects": [ { "type": "AcceptContract", "id": "c_grave_warden" } ] }, { "text": "Not yet.", "next": "mira_main" } ] },
        { "id": "mira_warden_done", "speaker": "Mira", "text": "The bells in Ashgrove rang this morning. They're saying your name, {player}.",
          "choices": [ { "text": "Let them.", "next": "mira_main" } ] },
        { "id": "mira_lore", "speaker": "Mira", "text": "Thornbury is just a crossing: my stall, Bram's forge and the hunt board. Past the ash fields is the old crypt. Lady Elowen speaks for the court at Ashgrove; she rarely notices folk like us.",
          "choices": [ { "text": "And the Gravebound?", "next": "mira_contract" } ] },
        { "id": "mira_courting", "speaker": "Mira", "text": "I... I'd like that. Meet me by the garden at dusk.",
          "choices": [ { "text": "I'll be there.", "next": "mira_main" } ] },
        { "id": "mira_engaged", "speaker": "Mira", "text": "Yes. A thousand times yes. Is there room at the cottage for my herbs?",
          "choices": [ { "text": "There's room for everything.", "next": "mira_main" } ] },
        { "id": "mira_wed", "speaker": "Mira", "text": "Then it's settled. I'll bring my garden to the cottage. It's our home now.",
          "choices": [ { "text": "Our home.", "effects": [ { "type": "CloseDialogue" } ] } ] },
        { "id": "mira_spouse", "speaker": "Mira", "conditions": [ { "type": "Flag", "id": "rel_mira_spouse" } ], "text": "There you are, love. The garden at home is thriving. What do you need?",
          "choices": [
            { "text": "The bridge is clear. Here are the bones.", "next": "mira_spouse", "hideWhenUnavailable": true, "conditions": [ { "type": "ContractStatus", "id": "c_gravebound_cull", "state": "Completed" } ], "effects": [ { "type": "ClaimContract", "id": "c_gravebound_cull" } ] },
            { "text": "Show me your remedies.", "effects": [ { "type": "OpenShop" } ] },
            { "text": "May I use your mortar and pestle?", "effects": [ { "type": "OpenCrafting" } ] },
            { "text": "I brought you something.", "effects": [ { "type": "OpenGift" } ] },
            { "text": "See you tonight.", "effects": [ { "type": "CloseDialogue" } ] } ] }
      ] },

    { "id": "d_bram", "entries": [ "bram_main" ],
      "nodes": [
        { "id": "bram_main", "speaker": "Bram", "text": "Bram. I work iron. Need something forged, or something to build with?",
          "choices": [
            { "text": "Use the forge.", "effects": [ { "type": "OpenCrafting" } ] },
            { "text": "Buy materials.", "effects": [ { "type": "OpenShop" } ] },
            { "text": "Any steady work?", "next": "bram_work", "hideWhenUnavailable": true, "conditions": [ { "type": "ContractStatus", "id": "c_bone_harvest", "state": "Available" } ] },
            { "text": "Here are the bones you wanted.", "next": "bram_main", "hideWhenUnavailable": true, "conditions": [ { "type": "ContractStatus", "id": "c_bone_harvest", "state": "Completed" } ], "effects": [ { "type": "ClaimContract", "id": "c_bone_harvest" } ] },
            { "text": "What can you make from Gravebound bone?", "next": "bram_bones" },
            { "text": "Goodbye.", "effects": [ { "type": "CloseDialogue" } ] } ] },
        { "id": "bram_bones", "speaker": "Bram", "text": "Bone dust folded into steel makes an edge the dead remember. Ribs make a fair vest, if you've grave iron to bind them. Bring me the Warden's iron someday and I'll make you a helm.",
          "choices": [ { "text": "Good to know.", "next": "bram_main" } ] },
        { "id": "bram_work", "speaker": "Bram", "text": "Six shards a day, every day, and I'll pay fair. The board will track it for you.",
          "choices": [ { "text": "Deal.", "next": "bram_main", "effects": [ { "type": "AcceptContract", "id": "c_bone_harvest" } ] }, { "text": "Maybe later.", "next": "bram_main" } ] }
      ] },

    { "id": "d_elowen", "entries": [ "elowen_court", "elowen_gate" ],
      "nodes": [
        { "id": "elowen_gate", "speaker": "Lady Elowen", "text": "The court of Ashgrove receives hunters of standing. Come back when your name means something, and when you have a roof worth the name.",
          "choices": [
            { "text": "I am a Silver Hunter, with an estate of my own.", "next": "elowen_court", "conditions": [ { "type": "Rank", "value": 2 }, { "type": "EstateTier", "value": 1 } ], "effects": [ { "type": "SetFlag", "id": "court_access" }, { "type": "Reputation", "id": "court", "value": 10 } ] },
            { "text": "I'll return.", "effects": [ { "type": "CloseDialogue" } ] } ] },
        { "id": "elowen_court", "speaker": "Lady Elowen", "conditions": [ { "type": "Flag", "id": "court_access" } ], "text": "Welcome to the court's favour, hunter. Ashgrove will send for you when it has work worthy of your blade.",
          "choices": [ { "text": "I await the summons.", "effects": [ { "type": "CloseDialogue" } ] } ] }
      ] }
  ],

