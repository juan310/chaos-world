<Project Sdk="Microsoft.NET.Sdk">
  <!-- Fast compile check of the WorldForge package on the Windows machine against the installed Unity 6 assemblies
       (runtime and editor code together; not used by Unity itself). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0649;CS0414;CS0169</NoWarn>
    <UnityManaged>C:\Program Files\Unity\Hub\Editor\6000.6.7f1\Editor\Data\Managed</UnityManaged>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\WorldForge\**\*.cs" />
    <Reference Include="$(UnityManaged)\UnityEngine\*.dll" Private="false" />
  </ItemGroup>
</Project>
